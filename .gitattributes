# Unity projects must keep LF line endings. Unity's YAML parser and
# .meta files are sensitive to CRLF churn, which shows up as whole-file
# diffs on Windows checkouts.
* text=auto eol=lf

# Binary assets - never diff or convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.exr binary
*.hdr binary
*.fbx binary
*.blend binary
*.mp3 binary
*.ogg binary
*.wav binary
*.aif binary
*.aiff binary
*.ttf binary
*.otf binary
*.mp4 binary
*.mov binary
*.unitypackage binary
*.dll binary
*.so binary
*.bundle binary
*.pdf binary

# LFS candidates: these are large binaries that grow over time.
*.wav filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text